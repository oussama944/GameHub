# ============================================================
# GameHub — modèle de configuration locale
# Copier en `.env` (gitignore) et adapter par machine
# ============================================================

# --- JWT : doit matcher auth-service ---
JWT_SECRET=change-me-must-match-auth-service

# --- Ollama (hôte) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Modèles IA ---
LIGHT_MODEL=qwen2.5:0.5b
HEAVY_MODEL=llama3.2:1b
AUTH_REQUIRED=true
LOG_LEVEL=INFO